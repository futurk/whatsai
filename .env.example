# Example Environment Variables
# Copy this file to .env.local and fill in your actual values

# OpenAI API Keys
EXPO_PUBLIC_OPENAI_API_KEY_PRIMARY=sk-your-primary-openai-key-here
EXPO_PUBLIC_OPENAI_API_KEY_SECONDARY=sk-your-secondary-openai-key-here

# Anthropic API Keys
EXPO_PUBLIC_ANTHROPIC_API_KEY_PRIMARY=sk-ant-your-anthropic-key-here

# Other API configurations
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_DEBUG_MODE=false